<article class="group relative flex h-full flex-col rounded-2xl border border-white/10 bg-white/[0.025] p-6 transition hover:-translate-y-0.5 hover:border-violet-300/30 hover:bg-white/[0.04] sm:p-7">
  <div class="mb-8 flex items-center justify-between">
    <span class="font-mono text-xs uppercase tracking-[0.16em] text-violet-300">{{ 'project.label'|trans }}</span>
    <span class="text-slate-600 transition group-hover:text-violet-300" aria-hidden="true">↗</span>
  </div>
  <h3 class="text-xl font-semibold tracking-tight text-white">
    <a class="focus:outline-none after:absolute after:inset-0 focus-visible:after:ring-2 focus-visible:after:ring-cyan-300" href="{{ path('app_project_show', {_locale: app.request.locale, slug: project.slug}) }}">{{ project.title }}</a>
  </h3>
  <p class="mt-3 flex-1 leading-7 text-slate-400">{{ project.summary }}</p>
  <div class="mt-6 flex flex-wrap gap-2">
    {% for technology in project.technologies|slice(0, 5) %}<twig:TechnologyBadge :technology="technology" />{% endfor %}
  </div>
</article>
