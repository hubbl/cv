<article class="card group relative flex h-full flex-col p-6 hover:-translate-y-0.5 sm:p-7">
  <div class="mb-8 flex items-center justify-between">
    <span class="meta-label">{{ 'project.label'|trans }}</span>
    <span class="muted-text transition group-hover:text-[var(--accent)]" aria-hidden="true">↗</span>
  </div>
  <h3 class="card-title text-xl">
    <a class="focus:outline-none after:absolute after:inset-0 focus-visible:after:ring-2" href="{{ path('app_project_show', {_locale: app.request.locale, slug: project.slug}) }}">{{ project.title }}</a>
  </h3>
  <p class="soft-text mt-3 flex-1 leading-7">{{ project.summary }}</p>
  <div class="mt-6 flex flex-wrap gap-2">
    {% for technology in project.technologies|slice(0, 5) %}<twig:TechnologyBadge :technology="technology" />{% endfor %}
  </div>
</article>
