<article class="card group relative grid gap-5 p-6 hover:-translate-y-0.5 sm:grid-cols-[9rem_1fr] sm:p-7">
  <div>
    <twig:Period :period="experience.period" />
  </div>
  <div>
    <p class="meta-label mb-1">{{ experience.company }}</p>
    <h3 class="card-title text-xl">
      <a class="focus:outline-none after:absolute after:inset-0 focus-visible:after:ring-2" href="{{ path('app_experience_show', {_locale: app.request.locale, slug: experience.slug}) }}">{{ experience.role }}</a>
    </h3>
    {% if experience.summary %}<div class="prose-compact mt-3 line-clamp-3">{{ experience.summary.html|raw }}</div>{% endif %}
    <div class="mt-5 flex flex-wrap gap-2">
      {% for technology in experience.technologies|slice(0, 5) %}<twig:TechnologyBadge :technology="technology" />{% endfor %}
    </div>
  </div>
</article>
