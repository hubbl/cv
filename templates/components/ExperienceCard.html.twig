<article class="group relative grid gap-5 rounded-2xl border border-white/10 bg-white/[0.025] p-6 transition hover:-translate-y-0.5 hover:border-cyan-300/25 hover:bg-white/[0.04] sm:grid-cols-[9rem_1fr] sm:p-7">
  <div>
    <twig:Period :period="experience.period" />
  </div>
  <div>
    <p class="mb-1 font-mono text-xs uppercase tracking-[0.16em] text-cyan-300">{{ experience.company }}</p>
    <h3 class="text-xl font-semibold tracking-tight text-white">
      <a class="focus:outline-none after:absolute after:inset-0 focus-visible:after:ring-2 focus-visible:after:ring-cyan-300" href="{{ path('app_experience_show', {_locale: app.request.locale, slug: experience.slug}) }}">{{ experience.role }}</a>
    </h3>
    {% if experience.summary %}<div class="prose-compact mt-3 line-clamp-3">{{ experience.summary.html|raw }}</div>{% endif %}
    <div class="mt-5 flex flex-wrap gap-2">
      {% for technology in experience.technologies|slice(0, 5) %}<twig:TechnologyBadge :technology="technology" />{% endfor %}
    </div>
  </div>
</article>
