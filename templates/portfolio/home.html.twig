{% extends 'base.html.twig' %}

{% block title %}{{ profile.name }} — {{ profile.title }}{% endblock %}
{% block meta_description %}{{ profile.tagline }}{% endblock %}

{% block body %}
  <section class="relative overflow-hidden border-b">
    <div class="pointer-events-none absolute inset-0 hero-grid opacity-40"></div>
    <div class="container-shell relative py-12">
      <div class="hero-layout">
        <div>
          <h1 class="hero-title">{{ profile.title|raw }}</h1>
          <p class="hero-tagline mt-8 text-lg leading-8 sm:text-xl">{{ profile.tagline }}</p>
        </div>
        <div class="hero-portrait-frame">
          <img class="hero-portrait" src="{{ asset('images/foto-profile.jpg') }}" alt="{{ profile.name }}" width="640" height="853" fetchpriority="high">
        </div>
      </div>
    </div>
  </section>

  <section class="section-space">
    <div class="container-shell grid gap-10 lg:grid-cols-[0.75fr_1.25fr]">
      <div><p class="eyebrow">{{ 'home.profile'|trans }}</p><h2 class="section-title">{{ profile.introductionTitle|raw }}</h2></div>
      <div class="prose-content text-lg">{{ profile.introduction.html|raw }}</div>
    </div>
    <div class="container-shell mt-16 flex flex-wrap gap-2 pt-7">
      {% for technology in profile.technologies %}<twig:TechnologyBadge :technology="technology" />{% endfor %}
    </div>
  </section>

  <section class="section-space tinted-section">
    <div class="container-shell">
      <div class="section-header"><div><p class="eyebrow">{{ 'navigation.experience'|trans }}</p><h2 class="section-title">{{ 'home.experience_title'|trans }}</h2></div><a class="text-link" href="{{ path('app_experience_index', {_locale: app.request.locale}) }}">{{ 'actions.view_all'|trans }} →</a></div>
      <div class="mt-12 grid gap-4">{% for experience in experiences %}<twig:ExperienceCard :experience="experience" />{% endfor %}</div>
    </div>
  </section>

  {% if profile.education or profile.languages or profile.certifications %}
    <section class="container-shell section-space" aria-labelledby="qualifications-title">
      <p class="eyebrow">{{ 'home.qualifications_eyebrow'|trans }}</p>
      <h2 id="qualifications-title" class="section-title">{{ 'home.qualifications_title'|trans }}</h2>
      <div class="profile-facts mt-10">
        {% if profile.education %}
          <section>
            <h3 class="profile-fact-heading">{{ 'home.education'|trans }}</h3>
            <div class="grid gap-5">
              {% for item in profile.education %}
                <div><p class="font-semibold">{{ item.title }}</p><p class="soft-text mt-1">{{ item.detail }}</p>{% if item.meta %}<p class="muted-text mt-1 text-sm">{{ item.meta }}</p>{% endif %}</div>
              {% endfor %}
            </div>
          </section>
        {% endif %}
        {% if profile.languages %}
          <section>
            <h3 class="profile-fact-heading">{{ 'home.languages'|trans }}</h3>
            <div class="grid gap-5">
              {% for item in profile.languages %}
                <div><p class="font-semibold">{{ item.title }}</p><p class="soft-text mt-1">{{ item.detail }}</p>{% if item.meta %}<p class="muted-text mt-1 text-sm">{{ item.meta }}</p>{% endif %}</div>
              {% endfor %}
            </div>
          </section>
        {% endif %}
        {% if profile.certifications %}
          <section>
            <h3 class="profile-fact-heading">{{ 'home.certifications'|trans }}</h3>
            <div class="grid gap-5">
              {% for item in profile.certifications %}
                <div><p class="font-semibold">{{ item.title }}</p><p class="soft-text mt-1">{{ item.detail }}</p>{% if item.meta %}<p class="muted-text mt-1 text-sm">{{ item.meta }}</p>{% endif %}</div>
              {% endfor %}
            </div>
          </section>
        {% endif %}
      </div>
    </section>
  {% endif %}

  <section class="section-space contact-section" aria-labelledby="contact-title">
    <div class="container-shell contact-layout">
      <div>
        <p class="eyebrow">{{ 'home.contact_eyebrow'|trans }}</p>
        <h2 id="contact-title" class="section-title">{{ 'home.contact_title'|trans }}</h2>
      </div>
      <div>
        <p class="contact-intro">{{ 'home.contact_intro'|trans }}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          {% if profile.email %}<a class="button-primary" href="mailto:{{ profile.email }}">{{ 'actions.write_email'|trans }}</a>{% endif %}
          {% if profile.phone %}<a class="button-secondary" href="tel:{{ profile.phone|replace({' ': '', '(0)': ''}) }}">{{ profile.phone }}</a>{% endif %}
          {% if profile.resume %}<a class="button-secondary" href="{{ asset(profile.resume) }}" target="_blank">{{ 'actions.view_resume'|trans }} <span aria-hidden="true">↗</span></a>{% endif %}
          {% for link in profile.links %}<a class="button-secondary" href="{{ link.url }}" target="_blank" rel="noreferrer">{{ link.label }} <span aria-hidden="true">↗</span></a>{% endfor %}
        </div>
      </div>
    </div>
  </section>

{% endblock %}
