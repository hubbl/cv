{% extends 'base.html.twig' %}

{% block title %}{{ profile.name }} — {{ profile.title }}{% endblock %}
{% block meta_description %}{{ profile.tagline }}{% endblock %}

{% block body %}
  <section class="relative overflow-hidden border-b border-white/10">
    <div class="pointer-events-none absolute inset-0 hero-grid opacity-40"></div>
    <div class="container-shell relative py-24 sm:py-32 lg:py-40">
      <p class="mb-6 flex items-center gap-3 font-mono text-xs uppercase tracking-[0.2em] text-cyan-300"><span class="h-px w-8 bg-cyan-300"></span>{{ profile.location }}</p>
      <h1 class="max-w-5xl text-5xl font-semibold leading-[0.98] tracking-[-0.045em] text-white sm:text-7xl lg:text-8xl">{{ profile.title }}</h1>
      <p class="mt-8 max-w-2xl text-lg leading-8 text-slate-400 sm:text-xl">{{ profile.tagline }}</p>
      <div class="mt-10 flex flex-wrap gap-3">
        {% for link in profile.links %}<a class="button-secondary" href="{{ link.url }}" target="_blank" rel="noreferrer">{{ link.label }} <span aria-hidden="true">↗</span></a>{% endfor %}
      </div>
      <div class="mt-16 flex max-w-3xl flex-wrap gap-2 border-t border-white/10 pt-7">
        {% for technology in profile.technologies %}<twig:TechnologyBadge :technology="technology" />{% endfor %}
      </div>
    </div>
  </section>

  <section class="section-space">
    <div class="container-shell grid gap-10 lg:grid-cols-[0.75fr_1.25fr]">
      <div><p class="eyebrow">01 / {{ 'home.profile'|trans }}</p><h2 class="section-title">{{ 'home.about_title'|trans }}</h2></div>
      <div class="prose-content text-lg">{{ profile.introduction.html|raw }}</div>
    </div>
  </section>

  <section class="section-space border-y border-white/10 bg-white/[0.015]">
    <div class="container-shell">
      <div class="section-header"><div><p class="eyebrow">02 / {{ 'navigation.experience'|trans }}</p><h2 class="section-title">{{ 'home.experience_title'|trans }}</h2></div><a class="text-link" href="{{ path('app_experience_index', {_locale: app.request.locale}) }}">{{ 'actions.view_all'|trans }} →</a></div>
      <div class="mt-12 grid gap-4">{% for experience in experiences %}<twig:ExperienceCard :experience="experience" />{% endfor %}</div>
    </div>
  </section>

  <section class="section-space">
    <div class="container-shell">
      <div class="section-header"><div><p class="eyebrow">03 / {{ 'navigation.projects'|trans }}</p><h2 class="section-title">{{ 'home.projects_title'|trans }}</h2></div><a class="text-link" href="{{ path('app_project_index', {_locale: app.request.locale}) }}">{{ 'actions.view_all'|trans }} →</a></div>
      <div class="mt-12 grid gap-4 md:grid-cols-2">{% for project in projects %}<twig:ProjectCard :project="project" />{% endfor %}</div>
    </div>
  </section>
{% endblock %}
