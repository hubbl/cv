{% extends 'base.html.twig' %}
{% block title %}404 — {{ 'error.not_found'|trans }}{% endblock %}
{% block body %}<section class="container-shell grid min-h-[70vh] place-items-center py-24 text-center"><div><p class="eyebrow">404</p><h1 class="page-title mt-4">{{ 'error.not_found'|trans }}</h1><p class="soft-text mt-4">{{ 'error.not_found_text'|trans }}</p><a class="button-secondary mt-8 inline-flex" href="{{ path('app_home', {_locale: app.request.locale in supported_locales ? app.request.locale : 'de'}) }}">{{ 'actions.home'|trans }}</a></div></section>{% endblock %}
