{% extends 'base.html.twig' %}
{% block title %}404 — {{ 'error.not_found'|trans }}{% endblock %}
{% block body %}<section class="container-shell grid min-h-[70vh] place-items-center py-24 text-center"><div><p class="font-mono text-sm text-cyan-300">404</p><h1 class="mt-4 text-4xl font-semibold text-white">{{ 'error.not_found'|trans }}</h1><p class="mt-4 text-slate-400">{{ 'error.not_found_text'|trans }}</p><a class="button-secondary mt-8 inline-flex" href="{{ path('app_home', {_locale: app.request.locale in supported_locales ? app.request.locale : 'de'}) }}">{{ 'actions.home'|trans }}</a></div></section>{% endblock %}
