{
    "name": "example/cv-portfolio",
    "description": "A multilingual, file-based CV and portfolio built with Symfony.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-iconv": "*",
        "league/commonmark": "^2.7",
        "symfony/asset": "8.1.*",
        "symfony/asset-mapper": "8.1.*",
        "symfony/cache": "8.1.*",
        "symfony/config": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dependency-injection": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2.7",
        "symfony/framework-bundle": "8.1.*",
        "symfony/html-sanitizer": "8.1.*",
        "symfony/http-kernel": "8.1.*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/runtime": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/ux-twig-component": "^2.30",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "8.1.*",
        "symfonycasts/tailwind-bundle": "^1.0",
        "twig/extra-bundle": "^3.18",
        "twig/twig": "^3.18"
    },
    "require-dev": {
        "deployer/deployer": "^8.0",
        "friendsofphp/php-cs-fixer": "^3.80",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^12.0",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/dom-crawler": "8.1.*",
        "symfony/phpunit-bridge": "8.1.*"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "App\\Tests\\": "tests/" }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "tailwind:build --minify": "symfony-cmd",
            "asset-map:compile": "symfony-cmd"
        },
        "post-install-cmd": ["@auto-scripts"],
        "post-update-cmd": ["@auto-scripts"],
        "qa": ["@test", "@phpstan", "@cs"],
        "test": "php bin/phpunit",
        "phpstan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    }
}
